N8N_VERSION=2.29.10
N8N_HOST_PORT=5678
TZ=Asia/Shanghai
GENERIC_TIMEZONE=Asia/Shanghai

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-local-admin-password

N8N_DB_NAME=n8n
N8N_DB_USER=n8n_app
N8N_DB_PASSWORD=replace-with-local-n8n-password
N8N_ENCRYPTION_KEY=replace-with-32-plus-random-characters
JWT_SECRET=replace-with-local-jwt-secret

SW_DB_NAME=stock_watch_mvp
SW_DB_USER=sw_app
SW_DB_PASSWORD=replace-with-local-stock-watch-password

MODEL_PROVIDER=MOCK
NOTIFY_ENABLED=false

JAVA_BRIDGE_ENABLED=false
JAVA_API_BASE_URL=http://host.docker.internal:8127
JAVA_API_TOKEN=

DEEPSEEK_ENABLED=false
DEEPSEEK_BASE_URL=http://host.docker.internal:8793/v1
DEEPSEEK_FACADE_API_KEY=
DEEPSEEK_FACADE_HOST_PORT=8793
MEETING_EVIDENCE_WEBHOOK_TOKEN=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
MAILPIT_UI_PORT=8025

QUOTE_FETCH_RETRY_COUNT=0
MODEL_RETRY_COUNT=0
NOTIFY_RETRY_COUNT=0

N8N_DIAGNOSTICS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_PYTHON_ENABLED=false
