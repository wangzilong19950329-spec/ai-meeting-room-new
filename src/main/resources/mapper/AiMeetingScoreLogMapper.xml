<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimeeting.room.dao.AiMeetingScoreLogMapper">

    <resultMap id="BaseResultMap" type="com.aimeeting.room.entity.AiMeetingScoreLog">
        <id column="id" property="id"/>
        <result column="meeting_id" property="meetingId"/>
        <result column="member_id" property="memberId"/>
        <result column="score_delta" property="scoreDelta"/>
        <result column="reason" property="reason"/>
        <result column="contribution_detail" property="contributionDetail"/>
        <result column="gmt_create" property="gmtCreate"/>
    </resultMap>

    <insert id="insert" parameterType="com.aimeeting.room.entity.AiMeetingScoreLog"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_meeting_score_log (meeting_id, member_id, score_delta, reason, contribution_detail)
        VALUES (#{meetingId}, #{memberId}, #{scoreDelta}, #{reason}, #{contributionDetail})
    </insert>

    <select id="selectByMeetingId" resultMap="BaseResultMap">
        SELECT * FROM ai_meeting_score_log WHERE meeting_id = #{meetingId} ORDER BY gmt_create
    </select>

    <select id="selectByMemberId" resultMap="BaseResultMap">
        SELECT * FROM ai_meeting_score_log WHERE member_id = #{memberId} ORDER BY gmt_create DESC
    </select>

    <delete id="deleteByMeetingId">
        DELETE FROM ai_meeting_score_log WHERE meeting_id = #{meetingId}
    </delete>

</mapper>
