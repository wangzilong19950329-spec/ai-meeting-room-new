<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimeeting.room.dao.AiMeetingCallLogMapper">
    <resultMap id="CallLogMap" type="com.aimeeting.room.entity.AiMeetingCallLog">
        <id column="id" property="id"/>
        <result column="meeting_id" property="meetingId"/>
        <result column="round_number" property="roundNumber"/>
        <result column="member_id" property="memberId"/>
        <result column="stage" property="stage"/>
        <result column="channel" property="channel"/>
        <result column="model" property="model"/>
        <result column="status" property="status"/>
        <result column="duration_ms" property="durationMs"/>
        <result column="prompt_tokens" property="promptTokens"/>
        <result column="completion_tokens" property="completionTokens"/>
        <result column="cache_hit_tokens" property="cacheHitTokens"/>
        <result column="prompt_chars" property="promptChars"/>
        <result column="completion_chars" property="completionChars"/>
        <result column="gmt_create" property="gmtCreate"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_meeting_call_log
        (meeting_id, round_number, member_id, stage, channel, model, status, duration_ms,
         prompt_tokens, completion_tokens, cache_hit_tokens, prompt_chars, completion_chars)
        VALUES (#{meetingId}, #{roundNumber}, #{memberId}, #{stage}, #{channel}, #{model}, #{status},
                #{durationMs}, #{promptTokens}, #{completionTokens}, #{cacheHitTokens},
                #{promptChars}, #{completionChars})
    </insert>

    <select id="selectByMeetingId" resultMap="CallLogMap">
        SELECT * FROM ai_meeting_call_log WHERE meeting_id = #{meetingId} ORDER BY id
    </select>

    <delete id="deleteByMeetingId">
        DELETE FROM ai_meeting_call_log WHERE meeting_id = #{meetingId}
    </delete>
</mapper>
