<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aimeeting.room.dao.AiSkillFileMapper">

    <resultMap id="BaseResultMap" type="com.aimeeting.room.entity.AiSkillFile">
        <id column="id" property="id"/>
        <result column="file_name" property="fileName"/>
        <result column="stored_name" property="storedName"/>
        <result column="content_type" property="contentType"/>
        <result column="file_size" property="fileSize"/>
        <result column="storage_path" property="storagePath"/>
        <result column="gmt_create" property="gmtCreate"/>
        <result column="gmt_modify" property="gmtModify"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ai_skill_file
        (file_name, stored_name, content_type, file_size, storage_path)
        VALUES
        (#{fileName}, #{storedName}, #{contentType}, #{fileSize}, #{storagePath})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM ai_skill_file WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM ai_skill_file ORDER BY id DESC
    </select>

    <select id="selectByIds" resultMap="BaseResultMap">
        SELECT * FROM ai_skill_file
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        ORDER BY id DESC
    </select>

    <delete id="deleteById">
        DELETE FROM ai_skill_file WHERE id = #{id}
    </delete>
</mapper>
